<Window x:Class="RoomReservation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Reservation Admin" Height="600" Width="900">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Rooms">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Load rooms" Height="35" Width="140" Margin="10"  Click="LoadRooms_Click"/>
                        <Button Content="Add room" Height="35" Width="140" Margin="10" Click="AddRoom_Click"/>
                        <Button Content="Save selected" Height="35" Width="140" Margin="10" Click="SaveRoom_Click"/>
                        <Button Content="Delete selected" Height="35" Width="140" Margin="10" Click="DeleteRoom_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="RoomsGrid" AutoGenerateColumns="True"/>

                </DockPanel>
            </TabItem>

            <TabItem Header="Reservations">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Load reservations" Height="35" Width="140" Margin="10" Click="LoadReservations_Click"/>
                        <Button Content="Cancel selected" Height="35" Width="140" Margin="10" Click="CancelReservation_Click"/>
                        <Button Content="Delete selected" Height="35" Width="140" Margin="10" Click="DeleteReservation_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ReservationsGrid" AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Users">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button  Content="Load users" Height="35" Width="140" Margin="10" HorizontalAlignment="Left" Click="LoadUsers_Click"/>
                        <Button  Content="Delete selected" Height="35" Width="140" Margin="10" HorizontalAlignment="Left" Click="DeleteUser_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>