@model RoomReservation.Web.ViewModels.RoomsIndexViewModel

@{
    ViewData["Title"] = "Rooms";
}

<h1>Rooms</h1>

<p>
    <a asp-controller="Reservations" asp-action="MyReservations">My reservations</a> |
    <a asp-controller="Profile" asp-action="Index">My profile</a> |
    <a asp-controller="Statistics" asp-action="Rooms">Statistics</a>
</p>

<h3>Filter rooms</h3>

<form asp-action="Index" method="get">
    <div>
        <label>From</label>
        <input asp-for="From" type="datetime-local" />
    </div>

    <div>
        <label>To</label>
        <input asp-for="To" type="datetime-local" />
    </div>

    <div>
        <label>Minimum capacity</label>
        <input asp-for="MinCapacity" type="number" min="1" />
    </div>

    <button type="submit">Filter</button>
    <a asp-controller="Rooms" asp-action="Index">Reset</a>
</form>

<hr />

<h4>Sort</h4>

<a asp-action="Index" asp-route-sort="name">Sort by name</a> |
<a asp-action="Index" asp-route-sort="capacity">Sort by capacity</a> |
<a asp-action="Index">Default</a>

<table border="1" cellpadding="6">
    <thead>
        <tr>
            <th>Name</th>
            <th>Capacity</th>
            <th>Equipment</th>
            <th>Max duration</th>
            <th>Availability</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Rooms)
        {
            <tr>
                <td>@item.Room.Name</td>
                <td>@item.Room.Capacity</td>
                <td>@item.Room.Equipment</td>
                <td>@item.Room.MaxReservationDurationMinutes minutes</td>
                <td>
                    @if (item.IsAvailable)
                    {
                        <span>Available</span>
                    }
                    else
                    {
                        <span>Occupied</span>
                    }
                </td>
                <td>
                    @if (item.IsAvailable)
                    {
                        <a asp-controller="Reservations"
                           asp-action="Create"
                           asp-route-roomId="@item.Room.Id">
                            Reserve
                        </a>
                    }
                    else
                    {
                        <span>Cannot reserve for selected time</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<form asp-controller="Account" asp-action="Logout" method="post" style="margin-top:20px;">
    <button type="submit">Logout</button>
</form>