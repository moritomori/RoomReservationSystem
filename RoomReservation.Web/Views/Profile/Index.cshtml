@model RoomReservation.Domain.Models.User

@{
    ViewData["Title"] = "Profile";
}

<h1>Profile</h1>

<p>
    <a asp-controller="Rooms" asp-action="Index">Back to rooms</a>
</p>

<div>
    <p><strong>Login:</strong> @Model.Login</p>
    <p><strong>Profile info:</strong> @Model.ProfileInfo</p>
    <p><strong>Created at:</strong> @Model.CreatedAt</p>
</div>

<hr />

<h3>AJAX profile refresh</h3>

<button type="button" onclick="loadProfileInfo()">Refresh profile info asynchronously</button>

<div id="profileAjaxResult" style="margin-top: 15px; border: 1px solid #ccc; padding: 10px;">
    AJAX data will appear here.
</div>

<script>
    async function loadProfileInfo() {
        const response = await fetch('/Profile/GetProfileInfo');

        if (!response.ok) {
            document.getElementById('profileAjaxResult').innerText = 'Cannot load profile info.';
            return;
        }

        const data = await response.json();

        document.getElementById('profileAjaxResult').innerHTML =
            '<strong>Login:</strong> ' + data.login + '<br />' +
            '<strong>Profile info:</strong> ' + (data.profileInfo ?? '') + '<br />' +
            '<strong>Created at:</strong> ' + data.createdAt;
    }
</script>