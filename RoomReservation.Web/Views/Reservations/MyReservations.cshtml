@model IEnumerable<RoomReservation.Common.DTOs.ReservationListItemDto>
@using RoomReservation.Common

@{
    ViewData["Title"] = "My reservations";
}

<h1>My reservations</h1>

<p>
    <a asp-controller="Rooms" asp-action="Index">Back to rooms</a>
</p>

<table border="1" cellpadding="6">
    <thead>
        <tr>
            <th>ID</th>
            <th>Room Name</th>
            <th>Start</th>
            <th>End</th>
            <th>Purpose</th>
            <th>People</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reservation in Model)
        {
            <tr>
                <td>@reservation.Id</td>
                <td>@reservation.RoomName</td>
                <td>@reservation.StartTime</td>
                <td>@reservation.EndTime</td>
                <td>@reservation.Purpose</td>
                <td>@reservation.NumberOfPeople</td>
                <td>@reservation.Status</td>
                <td>
                    @if (reservation.Status == Status.Active && reservation.StartTime > DateTime.Now)
                    {
                        <a asp-action="History" asp-route-id="@reservation.Id">History</a>

                        @if (reservation.Status == Status.Active && reservation.StartTime > DateTime.Now)
                        {
                            <span>|</span>
                            <a asp-action="Edit" asp-route-id="@reservation.Id">Edit</a>

                            <form asp-action="Cancel" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@reservation.Id" />
                                <button type="submit">Cancel</button>
                            </form>
                        }
                        else
                        {
                            <span>| Not available</span>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>